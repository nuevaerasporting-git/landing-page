# =====================================================================
# Copiar este archivo a .env.local y completar con los valores reales.
# Nunca commitear .env.local ni claves reales.
#
# Las claves de Supabase son solo de servidor: la app no usa el
# cliente de Supabase en el navegador. La autenticación es propia.
# NEXT_PUBLIC_SITE_URL sí es pública por diseño.
#
# Claves nuevas de Supabase: sb_publishable_... y sb_secret_...
# Proyectos viejos: anon key y service_role key.
# =====================================================================

# --- Supabase ---
SUPABASE_URL=https://<project-ref>.supabase.co

# Clave pública: solo se usa en el servidor para lecturas públicas.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_<...>

# SOLO SERVIDOR. Bypassea RLS. La usa el panel para leer y escribir.
# Nunca prefijar con NEXT_PUBLIC_ ni exponerla en el navegador.
SUPABASE_SECRET_KEY=sb_secret_<...>

# Alternativa legacy:
# SUPABASE_ANON_KEY=<anon-key>
# SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# --- Aplicación ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Duración absoluta de la sesión del panel, en horas (entero 1–24; default 12).
AUTH_SESSION_HOURS=12

# --- Opcional: conexión directa a Postgres ---
# Solo para migraciones o seeds manuales fuera del flujo de Supabase CLI.
# DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
