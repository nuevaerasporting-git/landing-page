# =====================================================================
# Copiar este archivo a .env.local y completar con los valores reales.
# Nunca commitear .env.local ni claves reales.
#
# Las claves nuevas de Supabase son sb_publishable_... y sb_secret_...
# Los proyectos viejos usan anon key y service_role key.
# =====================================================================

# --- Supabase: cliente (público, seguro de exponer) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<...>

# Alternativa legacy para proyectos que todavía usan la anon key:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# --- Supabase: solo servidor ---
# La aplicación usa RLS con la sesión del usuario y NO necesita estas claves.
# Usarlas solo en scripts administrativos locales. Bypassean RLS.
# Nunca prefijar con NEXT_PUBLIC_ ni exponerlas en el navegador.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_<...>

# --- Aplicación ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Opcional: conexión directa a Postgres ---
# Solo para migraciones o seeds manuales fuera del flujo de Supabase CLI.
# DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
